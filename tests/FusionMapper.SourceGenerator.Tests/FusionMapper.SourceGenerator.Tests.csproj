<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;Nullable</WarningsAsErrors>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
		<PackageReference Include="TUnit" Version="1.*" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\FusionMapper.SourceGenerator\FusionMapper.SourceGenerator.csproj" />
		<ProjectReference Include="..\..\src\FusionMapper\FusionMapper.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\FusionMapper.Tests\*.cs" Visible="false" />
	</ItemGroup>

</Project>
