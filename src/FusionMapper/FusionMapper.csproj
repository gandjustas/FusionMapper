<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>FusionMapper</PackageId>
		<AssemblyName>$(PackageId)</AssemblyName>
		<RootNamespace>$(PackageId)</RootNamespace>
		<SourceGenerator>$(PackageId).SourceGenerator</SourceGenerator>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;Nullable</WarningsAsErrors>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
		<ItemGroup>
			<None
				Include="$(MSBuildThisFileDirectory)..\$(SourceGenerator)\bin\$(Configuration)\netstandard2.0\$(SourceGenerator).dll"
				Pack="true"
				PackagePath="analyzers/dotnet/cs"
				Visible="false" />
			<None Include="$(PackageId).props" Pack="true" PackagePath="build" Visible="true" />
			<None Include="$(PackageId).targets" Pack="true" PackagePath="build" Visible="true" />
		</ItemGroup>
	</Target>
</Project>